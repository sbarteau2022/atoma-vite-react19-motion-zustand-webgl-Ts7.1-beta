    },
    {
      "binding": "RESEARCH",
      "database_name": "atoma-research-hub",
      "database_id": "dce06c8f-9ab6-4bd6-9c18-ed5c3a1ea78b",
      "migrations_dir": "migrations/research"
    }
  ]
}
